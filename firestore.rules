rules_version = '2';

// ============================================================
// Regras do Firestore — projeto dedicado ao 2V Parcerias
// ============================================================
// Leitura livre pra todo mundo. Escrita só pra quem estiver logado
// com uma das contas Google autorizadas abaixo.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function emailAutorizado() {
      return request.auth != null && request.auth.token.email in [
        "fredericoessinger@gmail.com",
        "manuela.goulart@grupotrigo.com.br",
        "gmanuelajacome@gmail.com",
        "acervo@girostraffic.page"
      ];
    }

    // ---- coleções atuais ----
    match /parceiros/{document=**}    { allow read: if true; allow write: if emailAutorizado(); }
    match /lancamentos/{document=**}  { allow read: if true; allow write: if emailAutorizado(); }
    match /config/{document=**}       { allow read: if true; allow write: if emailAutorizado(); }
    match /lojas/{document=**}        { allow read: if true; allow write: if emailAutorizado(); }
    match /grupos/{document=**}       { allow read: if true; allow write: if emailAutorizado(); }

    // ---- CRM (Fase 1 — schema novo, ver migracao.html) ----
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if emailAutorizado();
      match /interactions/{document=**} { allow read: if true; allow write: if emailAutorizado(); }
    }
    match /campaigns/{document=**}        { allow read: if true; allow write: if emailAutorizado(); }
    match /campaignPartners/{document=**} { allow read: if true; allow write: if emailAutorizado(); }
    match /coupons/{document=**}          { allow read: if true; allow write: if emailAutorizado(); }
    match /couponPartners/{document=**}   { allow read: if true; allow write: if emailAutorizado(); }
    match /tasks/{document=**}            { allow read: if true; allow write: if emailAutorizado(); }

    // Nada mais é exposto.
  }
}
